# database dumps
*.dump
*.sql.gz

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything except the committed templates.
# Note the negations: a bare `.env*` would also ignore .env.example, which is
# tracked on purpose and is the only documentation of what to set.
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python ETL
etl/__pycache__/
etl/*.pyc
etl/.venv/
etl/venv/
etl/.env

# data files
# All working data lives in runtime-data/ (multi-GB, never committed) or in
# Postgres. `data`, `etl`, and `scripts` are local convenience symlinks.
# See docs/data-storage.md for the full strategy.
runtime-data/
/data
/etl
/scripts

# playwright
/test-results/
/playwright-report/

# Per-developer Claude Code settings (machine-specific paths belong here,
# never in the committed .claude/settings.json).
.claude/settings.local.json

# reports/: client deliverables and drafts stay local. Files already tracked
# (the published libraries deep-dive) stay tracked; add a new published
# report deliberately with `git add -f`.
/reports/
