# === Portland Civic Lab — Environment Variables ===
#
# Copy this file to .env.local and fill in what you have. Every variable below
# is read somewhere in src/ or ingest/ (or by the WorkOS SDK, noted where that
# is the case). If you add a `process.env.X` to the code, add it here in the
# same change; if you delete the last reader of one, delete it here.
#
# The legacy Python ETL has its own separate list in
# ingest/legacy/python/.env.example. Nothing in the TypeScript app reads it.

# ─── Database ────────────────────────────────────────────────────────────
# Required in production, and for any local data work. There is no fallback
# and no mock mode: with this unset every query fails fast and the dashboards
# report dataStatus "unavailable".
DATABASE_URL=postgresql://postgres:password@localhost:5432/portland_dashboard

# ─── App ─────────────────────────────────────────────────────────────────
# Required in production. The Stripe checkout route refuses to build redirect
# URLs from the Host header without it. Ingest scripts that call the app back
# default to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron & authorization ────────────────────────────────────────────────
# Required in production: every /api/cron/* route rejects requests without it.
CRON_SECRET=

# Bearer token for /api/performance/*. Falls back to CRON_SECRET when unset,
# so it is optional.
PERFORMANCE_API_TOKEN=

# Comma-separated emails granted the admin role on sign-in. Optional.
ADMIN_EMAILS=

# Comma-separated emails offered pre-researched businesses to claim on /member.
# Claiming has no self-service undo, so leave this unset unless you are
# actively onboarding an owner. The direct link /member/business/claim/[slug]
# always works. Optional.
BUSINESS_CLAIM_EMAILS=

# Per-app shared secrets for the server-to-server account-resolution API
# (/api/internal/accounts/resolve). JSON map of app key -> secret (>=32 chars).
# Example: {"council":"<random-64-hex>","permits":"<random-64-hex>"}
# Required only if another Civic Lab app calls that endpoint.
CIVICLAB_INTERNAL_APP_SECRETS=

# ─── Membership auth (WorkOS AuthKit) ────────────────────────────────────
# Create an application at https://dashboard.workos.com and enable AuthKit.
# Sign-in/signup stay in "coming soon" mode until the first three are set.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# 32+ chars; generate with: openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=
# Read by the AuthKit SDK, not by our code. Optional in local dev; set to
# .portlandciviclab.org in production so sessions work across
# www.portlandciviclab.org and beds.portlandciviclab.org.
WORKOS_COOKIE_DOMAIN=
# Read by the AuthKit SDK. Must match the redirect URI configured in WorkOS.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# ─── Stripe donations ────────────────────────────────────────────────────
# Secret key: required for /donate to work at all. Never commit a real one.
STRIPE_SECRET_KEY=
# Webhook signing secret for /api/donate/webhook. Required in production —
# the route verifies every delivery against it.
STRIPE_WEBHOOK_SECRET=

# ─── AI Concierge (Claude) ───────────────────────────────────────────────
# Required for /concierge; the route reports itself unconfigured without it.
ANTHROPIC_API_KEY=

# ─── Email delivery ──────────────────────────────────────────────────────
# Used by the contact form and the outbound mailer. Configure EITHER Resend
# or SMTP. Both are optional; see the contact-form fallbacks below.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ─── Contact form ────────────────────────────────────────────────────────
# CONTACT_TO_EMAIL is the private recipient. Do not render it in public UI.
CONTACT_TO_EMAIL=
# The From address for both Resend and SMTP. Without it Resend is skipped and
# SMTP falls back to SMTP_USER.
CONTACT_FROM_EMAIL=

# Fallbacks when mail is not configured, in the order the route tries them.
# Database fallback: on Vercel it is on automatically when DATABASE_URL is
# set; locally set this to "true" to opt in.
CONTACT_DATABASE_FALLBACK=false
# Local-file fallback: on by default off Vercel, off by default on Vercel
# (whose filesystem is ephemeral). Set "true" to force it on.
CONTACT_STORE_FALLBACK=false
# Where the local-file fallback writes. Defaults to
# runtime-data/contact-submissions/.
CONTACT_FALLBACK_DIR=

# ─── Ingest: external data sources ───────────────────────────────────────
# All optional. Each is needed only by the scripts and crons that use it; a
# script without its key reports the source as unavailable rather than
# inventing data.

# Census API (free key: https://api.census.gov/data/key_signup.html).
# Used by the Census fetchers and /api/cron/refresh-data.
CENSUS_API_KEY=

# AirNow (https://docs.airnowapi.org/). Used by /api/cron/sync-aqi and
# ingest/fetch-airnow.ts.
AIRNOW_API_KEY=

# Portland Maps permit detail API. ingest/scrape-permit-details-*.ts fall back
# to a shared public key when unset.
PORTLAND_MAPS_API_KEY=

# Bureau of Economic Analysis (https://apps.bea.gov/API/signup/).
# Used by ingest/fetch-peer-metros-extended.ts.
BEA_API_KEY=

# HUD USER API token (https://www.huduser.gov/portal/dataset/api.html).
# Used by ingest/fetch-hud-vacancy.ts.
HUD_API_TOKEN=

# ─── Ingest: script behaviour ────────────────────────────────────────────
# Directory of PBJ (Payroll Based Journal) input files for
# ingest/sync-pbj-records.ts (--input does the same thing). With neither set
# the script falls back to ../../../intelligence/bizjournals-records/... —
# a path outside this repository that exists on one machine only, so set this.
PBJ_INPUT_DIR=
# Permit detail scraper throttle (ingest/scrape-permit-details-v2.ts).
# Defaults: 5 concurrent requests, 200 ms between them.
PERMIT_DETAIL_CONCURRENT=5
PERMIT_DETAIL_DELAY_MS=200
