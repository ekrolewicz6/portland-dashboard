{
  "name": "portland-civic-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:studio": "drizzle-kit studio",
    "seed": "npx tsx ingest/seed-real-data.ts",
    "fetch:external": "npx tsx ingest/fetch-external-sources.ts",
    "fetch:trimet": "npx tsx ingest/fetch-trimet-gtfs.ts",
    "fetch:fbi": "npx tsx ingest/fetch-fbi-crime.ts",
    "fetch:housing": "npx tsx ingest/fetch-housing-data.ts",
    "fetch:employment": "npx tsx ingest/fetch-oregon-employment.ts",
    "scrape:permits": "npx tsx ingest/scrape-permit-details.ts",
    "analyze:bottlenecks": "npx tsx ingest/analyze-permit-bottlenecks.ts",
    "test": "playwright test",
    "budget:fetch": "npx tsx ingest/budget/fetch-books.ts",
    "budget:inspect": "npx tsx ingest/budget/inspect-pages.ts",
    "budget:parse": "npx tsx ingest/budget/parse-vol1-funds.ts && npx tsx ingest/budget/parse-vol2-programs.ts && npx tsx ingest/budget/parse-citywide.ts",
    "budget:verify": "npx tsx ingest/budget/reconcile.ts",
    "budget:build": "npm run budget:fetch && npm run budget:parse && npm run budget:verify && npx tsx ingest/budget/build-dataset.ts",
    "business:verify": "npx tsx --env-file=.env.local ingest/business/verify-catalog.ts",
    "business:boundaries": "npx tsx ingest/business/fetch-boundaries.ts",
    "pps:harvest": "tsx ingest/pps-budget/harvest-index.ts",
    "pps:archive": "tsx ingest/pps-budget/archive.ts",
    "pps:fetch": "tsx ingest/pps-budget/fetch.ts --tier 2",
    "db:migrate": "npx tsx ingest/apply-migration.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@workos-inc/authkit-nextjs": "^4.1.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next": "^15.3.3",
    "nodemailer": "^9.1.1",
    "postgres": "^3.4.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.3",
    "stripe": "^22.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ekrolewicz6/portland-civic-lab.git"
  }
}
